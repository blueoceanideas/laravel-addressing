{
	"name": "galahad/laravel-addressing",
	"description": "Laravel package providing addressing functionality",
	"keywords": [
		"laravel",
		"address",
		"addressing",
		"validation",
		"countries"
	],
	"type": "library",
	"homepage": "https://github.com/glhd/laravel-addressing",
	"authors": [
		{
			"name": "Chris Morrell",
			"homepage": "http://github.com/inxilpro"
		},
		{
			"name": "Junior Grossi",
			"email": "juniorgro@gmail.com",
			"homepage": "http://github.com/jgrossi"
		}
	],
	"require": {
		"php": "^8.3",
		"illuminate/contracts": "^10.14|^11|^12",
		"illuminate/support": "^10.14|^11|^12",
		"illuminate/http": "^10.14|^11|^12",
		"illuminate/routing": "^10.14|^11|^12",
		"illuminate/validation": "^10.14|^11|^12",
		"commerceguys/addressing": "^v2.3",
		"symfony/intl": "^7.0",
		"commerceguys/intl": "^2.0",
		"doctrine/collections": "^2.2"
	},
	"require-dev": {
		"ext-json": "*",
		"phpunit/phpunit": "^10",
		"orchestra/testbench": "^8.0",
		"friendsofphp/php-cs-fixer": "^3.0"
	},
    "config": {
      "policy": {
        "advisories": {
          "ignore-id": ["PKSA-m5cs-t1y6-qpcs", "PKSA-3r5d-mb8f-1qw9", "PKSA-mdq4-51ck-6kdq", "PKSA-8qx3-n5y5-vvnd", "PKSA-w7xr-vk7n-rstm"]
        }
      }
    },
	"autoload": {
		"psr-4": {
			"Galahad\\LaravelAddressing\\": "src/"
		}
	},
	"autoload-dev": {
		"classmap": [
			"tests/TestCase.php"
		],
		"psr-4": {
			"Galahad\\LaravelAddressing\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"fix-style": "vendor/bin/php-cs-fixer fix",
		"check-style": "vendor/bin/php-cs-fixer fix --diff --dry-run"
	},
	"license": "MIT",
	"extra": {
		"laravel": {
			"providers": [
				"Galahad\\LaravelAddressing\\Support\\AddressingServiceProvider"
			],
			"aliases": {
				"Addressing": "Galahad\\LaravelAddressing\\Support\\Facades\\Addressing"
			}
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true
}
